# Copie este arquivo para .env (somente para rodar no seu computador).
# Na Vercel, o DATABASE_URL é cadastrado sozinho quando você conecta o banco Neon
# ao projeto (Storage > seu banco > Connect Project). Você só cadastra JWT_SECRET e APP_TIMEZONE.

# String de conexão do Neon (versão "pooled", com -pooler no endereço)
DATABASE_URL=postgresql://usuario:senha@ep-exemplo-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Texto longo e aleatório que assina os logins. Gere um com: npm run gen-secret
JWT_SECRET=troque-por-um-texto-longo-e-aleatorio

# Fuso usado para saber o que é "hoje" e quais horários já passaram
APP_TIMEZONE=America/Sao_Paulo

# Acesso privado à central de cobranças em /owner. Use uma senha longa e exclusiva.
OWNER_EMAIL=seu-email-de-proprietario@exemplo.com
OWNER_PASSWORD=troque-por-uma-senha-aleatoria-com-pelo-menos-12-caracteres
